  "narrative": {
    "northStar": "The Source-Pinned Racing Stage",
    "overview": "The visual authority is the Lando Norris / OFF+BRAND homepage, adapted to Max Verstappen for a personal, noncommercial frontend exercise. Preserve its cinematic scroll rhythm, oversized mixed type, lime-and-olive palette, photographic scale and animated controls. This is a description of the implemented system, not permission to invent a new Max identity.\n\nEnglish carries the large compositions; Chinese supports comprehension beneath them. The current WebGL helmet retains the reference mesh with projected Max photography; portrait depth/normals are approximations; the signature is a raster reveal rather than a reconstructed vector stroke animation. Sixteen helmet positions show multiple views of three designs, not sixteen unique designs. These limits preclude claims of complete fidelity.",
    "keyCharacteristics": [
      "Full-viewport scenes and scroll-driven transformations.",
      "Compressed uppercase Mona Sans paired with expressive Brier.",
      "Acid lime controls against warm olive and chalk surfaces.",
      "Large photography, clipped reveals and restrained bilingual support."
    ],
    "rules": [
      {
        "name": "The Reference Palette Rule",
        "body": "Subject replacement must not introduce a new team-color theme or recolor reference controls.",
        "section": "colors"
      },
      {
        "name": "The English Composition Rule",
        "body": "Keep Chinese explanatory copy subordinate to the English display; do not force long translations into the original display line boxes.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do compare changes at the same viewport and scroll position as the reference.",
      "Do preserve original DOM hooks, Rive controls, fluid sizing and scene rhythm.",
      "Do keep English display copy prominent and Chinese support readable.",
      "Do keep fidelity limits explicit when describing the result."
    ],
    "donts": [
      "Don't replace the pinned layout or button system with a newly invented sports theme.",
      "Don't describe the helmet mesh, portrait depth or raster signature as authentic Max 3D/vector reconstructions.",
      "Don't present sixteen helmet views as sixteen distinct designs or sample race data as live scheduling."
    ]
  }
